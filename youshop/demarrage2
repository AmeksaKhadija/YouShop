9. CONNEXION WEBSOCKET
================================================================================

// Cote client (JavaScript)
import { io } from 'socket.io-client';

const socket = io('http://localhost:3000/notifications', {
  auth: {
    token: 'votre-jwt-token'
  }
});

// Connexion reussie
socket.on('connected', (data) => {
  console.log('Connecte:', data);
});

// Ecouter les notifications de paiement
socket.on('payment:success', (notification) => {
  console.log('Paiement reussi:', notification);
  // { type: 'PAYMENT_SUCCESS', title: '...', message: '...', data: {...} }
});

socket.on('payment:failed', (notification) => {
  console.log('Paiement echoue:', notification);
});

// Ecouter les mises a jour de commande
socket.on('order:status', (notification) => {
  console.log('Statut commande:', notification);
});

// Pour les admins: alertes de stock
socket.on('stock:low', (alert) => {
  console.log('Stock bas:', alert);
});

socket.on('stock:out', (alert) => {
  console.log('Rupture de stock:', alert);
});

