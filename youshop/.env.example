# YouShop Backend Environment Configuration

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/youshop?schema=public"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Application
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:3001"

# Tax Rate (20% TVA)
TAX_RATE=0.20

# Order Expiration (30 minutes in milliseconds)
ORDER_EXPIRATION_MS=1800000
